{
  "name": "mcpspy",
  "version": "0.1.0",
  "description": "Inspection proxy for Model Context Protocol servers: see, replay and mock the JSON-RPC traffic between AI agents and MCP servers.",
  "license": "MIT",
  "author": "Jarryd Hoffman",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jarryd-W-Hoffman/mcp-spy.git"
  },
  "homepage": "https://github.com/Jarryd-W-Hoffman/mcp-spy#readme",
  "bugs": {
    "url": "https://github.com/Jarryd-W-Hoffman/mcp-spy/issues"
  },
  "type": "module",
  "bin": {
    "mcpspy": "dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build",
    "dev": "tsx src/bin.ts",
    "dev:ui": "vite",
    "typecheck": "tsc --noEmit && tsc --noEmit -p ui",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "node bench/bench.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "zod": "4.6.7"
  }
}
